  "memory": {
    "start_min_available_bytes": 96636764160,
    "evidence": "estimated",
    "note": "90 GiB is the floor the benchmark used before restoring the Qwen3.8-27B deployment on a 128 GiB GB10. SGLang reported 25.02 GB weights and a 10.12 GB KV pool at this static fraction; host MemAvailable was about 49 GiB after start (2026-09-17 post). Differences from the site's own deployment: no patched chat template, no API key (the engine listens on 127.0.0.1 only) and no keepalive proxy, so long silent tool calls reach the client unfiltered. Readiness: this site's notes give about 7 minutes after a restart and Alzeo reports 7-9 minutes for a first boot and 3.5-6.5 minutes later; ready_timeout 20m is a watchdog above both, not a measurement.",
    "recorded_at": "2026-09-17T00:00:00Z"
  }
